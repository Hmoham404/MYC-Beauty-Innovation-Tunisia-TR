{
  "version": 2,
  "buildCommand": "cd client && npm install --legacy-peer-deps && npm run build && cd ../server && npm install --legacy-peer-deps",
  "installCommand": "npm install --legacy-peer-deps",
  "env": {
    "NODE_ENV": "production"
  },
  "functions": {
    "server/server.js": {
      "includeFiles": "client/dist/**"
    }
  },
  "builds": [
    {
      "src": "server/server.js",
      "use": "@vercel/node",
      "config": {
        "zeroConfig": true
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server/server.js"
    }
  ]
}
