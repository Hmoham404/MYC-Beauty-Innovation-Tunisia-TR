# Server Configuration
PORT=5000
NODE_ENV=production

# CORS Configuration
# Leave empty or use * for development
# For production, set to your Vercel domain
CORS_ORIGIN=*

# API Configuration (optional - for development)
VITE_API_URL=http://localhost:5000

# File Upload Configuration
# Maximum file size in bytes (50MB default)
MAX_FILE_SIZE=52428800

# Translation Service (if using external service)
# TRANSLATION_API_KEY=your_key_here
# TRANSLATION_API_URL=https://api.service.com
